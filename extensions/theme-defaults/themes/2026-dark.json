	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#73a96b",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#78aee8"
			}
		},
		{
			"name": "Functions and methods",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#d8c07b"
			}
		},
		{
			"name": "Types, modules, and attributes",
			"scope": [
				"entity.name.type",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"meta.module-reference",
				"entity.other.attribute-name",
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor"
			],
			"settings": {
				"foreground": "#66cbbb"
			}
		},
		{
			"name": "Classes, symbols, and constants",
			"scope": [
				"entity.name.type.class",
				"constant",
				"variable.other.constant",
				"entity.name.constant",
				"constant.language",
				"constant.numeric"
			],
			"settings": {
				"foreground": "#c792d4"
			}
		},
		{
			"name": "Strings and selectors",
			"scope": [
				"string",
				"constant.other.symbol",
				"entity.name.tag",
				"meta.selector",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#7fbd73"
			}
		},
		{
			"name": "Variables, objects, and properties",
			"scope": [
				"variable",
				"support.variable",
				"variable.other.property",
				"meta.object-literal.key",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#8ed7cc"
			}
		},
		{
			"name": "Valor service sections and attributes",
			"scope": [
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor",
				"entity.name.namespace.valor"
			],
			"settings": {
				"foreground": "#d8c07b"
			}
		},
		{
			"name": "Valor class declarations",
			"scope": [
				"entity.name.type.class.valor"
			],
			"settings": {
				"foreground": "#c792d4"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"meta.embedded.line"
			],
			"settings": {
				"foreground": "#78aee8"
			}
		},
		{
			"name": "Regular expressions",
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#7fbd73"
			}
		},
		{
			"name": "Invalid and errors",
			"scope": [
				"invalid",
				"message.error",
				"token.error-token"
			],
			"settings": {
				"foreground": "#e86d78"
			}
		},
		{
			"name": "Warnings",
			"scope": [
				"token.warn-token"
			],
			"settings": {
				"foreground": "#d8c07b"
			}
		},
		{
			"name": "Markup headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#d8c07b",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup quotes",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#7fbd73"
			}
		},
		{
			"name": "Markup bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#dce7ea",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#dce7ea",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup links",
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#d8c07b",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Diff inserted",
			"scope": [
				"markup.inserted",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#7fbd73"
			}
		},
		{
			"name": "Diff deleted",
			"scope": [
				"markup.deleted",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#e86d78"
			}
		},
		{
			"name": "Diff changed",
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#d8c07b"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"keyword": "#78aee8",
		"modifier": "#78aee8",
		"function": "#d8c07b",
		"method": "#d8c07b",
		"class": "#c792d4",
		"struct": "#d8c07b",
		"interface": "#d8c07b",
		"type": "#d8c07b",
		"typeParameter": "#d8c07b",
		"namespace": "#d8c07b",
		"decorator": "#d8c07b",
		"event": "#d8c07b",
		"macro": "#d8c07b",
		"label": "#d8c07b",
		"operator": "#78aee8",
		"variable": "#8ed7cc",
		"parameter": "#8ed7cc",
		"property": "#8ed7cc",
		"enum": "#c792d4",
		"enumMember": "#c792d4",
		"string": "#7fbd73",
		"number": "#c792d4",
		"regexp": "#7fbd73",
		"newOperator": "#78aee8",
		"stringLiteral": "#7fbd73",
		"customLiteral": "#c792d4",
		"numberLiteral": "#c792d4",
		"comment": {
			"foreground": "#73a96b",
			"italic": true
		}
	}
}
