	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#ffffff99",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#e2d3fe"
			}
		},
		{
			"name": "Functions and methods",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#8dc8fb"
			}
		},
		{
			"name": "Types, modules, and attributes",
			"scope": [
				"entity.name.type",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"meta.module-reference",
				"entity.other.attribute-name",
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor"
			],
			"settings": {
				"foreground": "#ffcf99"
			}
		},
		{
			"name": "Classes, symbols, and constants",
			"scope": [
				"entity.name.type.class",
				"constant",
				"variable.other.constant",
				"entity.name.constant",
				"constant.language",
				"constant.numeric"
			],
			"settings": {
				"foreground": "#ff80b5"
			}
		},
		{
			"name": "Strings and selectors",
			"scope": [
				"string",
				"constant.other.symbol",
				"entity.name.tag",
				"meta.selector",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#80ffb5"
			}
		},
		{
			"name": "Variables, objects, and properties",
			"scope": [
				"variable",
				"support.variable",
				"variable.other.property",
				"meta.object-literal.key",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#80f4ff"
			}
		},
		{
			"name": "Valor service sections and attributes",
			"scope": [
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor",
				"entity.name.namespace.valor"
			],
			"settings": {
				"foreground": "#ffcf99"
			}
		},
		{
			"name": "Valor class declarations",
			"scope": [
				"entity.name.type.class.valor"
			],
			"settings": {
				"foreground": "#ff80b5"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"meta.embedded.line"
			],
			"settings": {
				"foreground": "#e2d3fe"
			}
		},
		{
			"name": "Regular expressions",
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#80ffb5"
			}
		},
		{
			"name": "Invalid and errors",
			"scope": [
				"invalid",
				"message.error",
				"token.error-token"
			],
			"settings": {
				"foreground": "#ff8080"
			}
		},
		{
			"name": "Warnings",
			"scope": [
				"token.warn-token"
			],
			"settings": {
				"foreground": "#ffcf99"
			}
		},
		{
			"name": "Markup headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#8dc8fb",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup quotes",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#80ffb5"
			}
		},
		{
			"name": "Markup bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup links",
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#8dc8fb",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Diff inserted",
			"scope": [
				"markup.inserted",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#80ffb5"
			}
		},
		{
			"name": "Diff deleted",
			"scope": [
				"markup.deleted",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#ff8080"
			}
		},
		{
			"name": "Diff changed",
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#ffcf99"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"keyword": "#e2d3fe",
		"modifier": "#e2d3fe",
		"function": "#8dc8fb",
		"method": "#8dc8fb",
		"class": "#ff80b5",
		"struct": "#ffcf99",
		"interface": "#ffcf99",
		"type": "#ffcf99",
		"typeParameter": "#ffcf99",
		"namespace": "#ffcf99",
		"decorator": "#ffcf99",
		"event": "#8dc8fb",
		"macro": "#8dc8fb",
		"label": "#ffcf99",
		"operator": "#e2d3fe",
		"variable": "#80f4ff",
		"parameter": "#80f4ff",
		"property": "#80f4ff",
		"enum": "#ff80b5",
		"enumMember": "#ff80b5",
		"string": "#80ffb5",
		"number": "#ff80b5",
		"regexp": "#80ffb5",
		"newOperator": "#e2d3fe",
		"stringLiteral": "#80ffb5",
		"customLiteral": "#ff80b5",
		"numberLiteral": "#ff80b5",
		"comment": {
			"foreground": "#ffffff99",
			"italic": true
		}
	}
}
