	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#352f3d99",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#876eb1"
			}
		},
		{
			"name": "Functions and methods",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#2d6a9f"
			}
		},
		{
			"name": "Types, modules, and attributes",
			"scope": [
				"entity.name.type",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"meta.module-reference",
				"entity.other.attribute-name",
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor"
			],
			"settings": {
				"foreground": "#d08025"
			}
		},
		{
			"name": "Classes, symbols, and constants",
			"scope": [
				"entity.name.type.class",
				"constant",
				"variable.other.constant",
				"entity.name.constant",
				"constant.language",
				"constant.numeric"
			],
			"settings": {
				"foreground": "#c80e5c"
			}
		},
		{
			"name": "Strings and selectors",
			"scope": [
				"string",
				"constant.other.symbol",
				"entity.name.tag",
				"meta.selector",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#367c53"
			}
		},
		{
			"name": "Variables, objects, and properties",
			"scope": [
				"variable",
				"support.variable",
				"variable.other.property",
				"meta.object-literal.key",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#0c9aa7"
			}
		},
		{
			"name": "Valor service sections and attributes",
			"scope": [
				"entity.name.tag.service-section.valor",
				"entity.name.attribute.valor",
				"entity.name.namespace.valor"
			],
			"settings": {
				"foreground": "#d08025"
			}
		},
		{
			"name": "Valor class declarations",
			"scope": [
				"entity.name.type.class.valor"
			],
			"settings": {
				"foreground": "#c80e5c"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"meta.embedded.line"
			],
			"settings": {
				"foreground": "#876eb1"
			}
		},
		{
			"name": "Regular expressions",
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#367c53"
			}
		},
		{
			"name": "Invalid and errors",
			"scope": [
				"invalid",
				"message.error",
				"token.error-token"
			],
			"settings": {
				"foreground": "#993333"
			}
		},
		{
			"name": "Warnings",
			"scope": [
				"token.warn-token"
			],
			"settings": {
				"foreground": "#d08025"
			}
		},
		{
			"name": "Markup headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#2d6a9f",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup quotes",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#367c53"
			}
		},
		{
			"name": "Markup bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#352f3d",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#352f3d",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup links",
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#2d6a9f",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Diff inserted",
			"scope": [
				"markup.inserted",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#367c53"
			}
		},
		{
			"name": "Diff deleted",
			"scope": [
				"markup.deleted",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#993333"
			}
		},
		{
			"name": "Diff changed",
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#d08025"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"keyword": "#876eb1",
		"modifier": "#876eb1",
		"function": "#2d6a9f",
		"method": "#2d6a9f",
		"class": "#c80e5c",
		"struct": "#d08025",
		"interface": "#d08025",
		"type": "#d08025",
		"typeParameter": "#d08025",
		"namespace": "#d08025",
		"decorator": "#d08025",
		"event": "#2d6a9f",
		"macro": "#2d6a9f",
		"label": "#d08025",
		"operator": "#876eb1",
		"variable": "#0c9aa7",
		"parameter": "#0c9aa7",
		"property": "#0c9aa7",
		"enum": "#c80e5c",
		"enumMember": "#c80e5c",
		"string": "#367c53",
		"number": "#c80e5c",
		"regexp": "#367c53",
		"newOperator": "#876eb1",
		"stringLiteral": "#367c53",
		"customLiteral": "#c80e5c",
		"numberLiteral": "#c80e5c",
		"comment": {
			"foreground": "#352f3d99",
			"italic": true
		}
	}
}
